# Conexão com o PostgreSQL. Na nuvem (Neon), use a URL do painel com ?sslmode=require
DATABASE_URL=postgres://gestao:gestao@localhost:5432/gestao

# Segredo para assinar os tokens JWT: obrigatório em produção, com 32+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Validade do token (horas)
JWT_VALIDADE_HORAS=8

# Insere usuários e projetos de demonstração quando o banco está vazio
SEED_DEMO=true
SEED_SENHA=senha123

# Regras de alerta das rubricas (GP-10), em % do orçamento comprometido
ALERTA_ATENCAO_PERCENTUAL=80
ALERTA_CRITICO_PERCENTUAL=100

# Somente para testes de falha: atraso por requisição e taxa de erro 503
MOCK_DELAY_MS=0
MOCK_FAIL_RATE=0
