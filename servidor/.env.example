# Copie para .env e preencha. NÃO versione o .env.

# Senha do PostgreSQL (o banco não é exposto na rede, mas use uma senha forte)
POSTGRES_PASSWORD=

# Segredo dos tokens JWT (32+ caracteres). Gere com:
#   openssl rand -base64 48
JWT_SECRET=

# Endereço público do servidor:
#   com domínio:  gestao.seudominio.com
#   só com IP:    192.168.0.50   (IP da rede local) ou o IP público
# Sem "https://": o Caddy sempre serve em HTTPS e redireciona o HTTP.
SITE_ENDERECO=192.168.0.50

# internal = certificado próprio do Caddy (o app precisa confiar nele; ver docs/servidor-proprio.md)
# seu@email.com = certificado do Let's Encrypt (só com domínio)
TLS=internal

# Dados de demonstração no primeiro start (banco vazio). Depois pode deixar false.
SEED_DEMO=true
SEED_SENHA=
